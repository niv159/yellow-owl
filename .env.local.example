# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored — never commit real keys.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# Google Gemini (free) → aistudio.google.com → Get API key
GEMINI_API_KEY=AIza...

# A long random password you make up — used to call /api/seed
ADMIN_SECRET=change-this-to-something-long-and-random
