# Yellow Owl — deployment credentials
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file to .env.deploy (same folder)
# 2. Fill in the 4 tokens below (each takes ~2 min to create)
# 3. Run:  node deploy.js
# ─────────────────────────────────────────────────────────────────────────────
# .env.deploy is git-ignored — your secrets never leave this machine.

# ── GitHub ────────────────────────────────────────────────────────────────────
# github.com → avatar → Settings → Developer settings
#   → Personal access tokens → Tokens (classic) → Generate → tick "repo" only
GITHUB_TOKEN=ghp_...

# ── Supabase ──────────────────────────────────────────────────────────────────
# supabase.com → avatar → Access Tokens → Generate new token
SUPABASE_TOKEN=sbp_...

# ── Vercel ────────────────────────────────────────────────────────────────────
# vercel.com → Settings → Tokens → Create (Full Account scope)
VERCEL_TOKEN=...

# ── Google Gemini (FREE — no credit card needed) ──────────────────────────────
# aistudio.google.com → sign in with Google → Get API key → Create API key
GEMINI_API_KEY=AIza...

# ── Admin secret ─────────────────────────────────────────────────────────────
# Make up any long random password. deploy.js generates one if left blank.
ADMIN_SECRET=
